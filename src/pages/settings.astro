---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SettingsIsland } from '../components/SettingsIsland';
import { getServerLanguage } from '../lib/i18n/getServerLanguage';
import { t } from '../lib/i18n/strings';

const lang = getServerLanguage(Astro);
---
<BaseLayout
  title={t('page.settings.title', lang)}
  ogTitle={`${t('page.settings.title', lang)} | Pachacuti`}
  ogDescription={t('page.settings.subtitle', lang)}
>
  <div class="fixed inset-0 -z-10">
    <img src="/art/backgrounds/ui/tocapu-dark.webp" alt="" class="w-full h-full object-cover opacity-40" />
    <div class="absolute inset-0 bg-gradient-to-b from-volcanic/70 via-volcanic/60 to-volcanic/80"></div>
  </div>
  <main class="max-w-2xl mx-auto px-4 md:px-8 py-8 md:py-12" data-testid="settings-page">
    {/* Header */}
    <header class="text-center mb-10">
      <h1 class="font-heading-decorative text-3xl md:text-4xl text-gold mb-3">
        {t('page.settings.title', lang)}
      </h1>
      <p class="font-body text-text-secondary text-lg">
        {t('page.settings.subtitle', lang)}
      </p>
    </header>

    {/* Settings controls -- React island handles all interactive state */}
    <SettingsIsland client:load />
  </main>
</BaseLayout>
