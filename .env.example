# Pachacuti Audiobook Experience
# Copy this file to .env and fill in values

# === Phase 1: Asset Pipeline ===
# No env vars needed for Phase 1

# === Phase 4: Audio Player ===
# (none -- client-side only)

# === Phase 5: Auth + Protection ===
# Better Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:4321
PUBLIC_BETTER_AUTH_URL=http://localhost:4321

# Resend (magic link email)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000
PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000

# PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://pachacuti:password@localhost:5432/pachacuti

# Audio token signing
AUDIO_TOKEN_SECRET=your-audio-token-secret

# === Phase 7.7: Content Encryption ===
# Master encryption key (64-char hex). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_MASTER_KEY=your-64-char-hex-key-here

# Feature flag: enable encrypted content delivery (set to "true" to enable)
PUBLIC_ENABLE_ENCRYPTION=false

# === Phase 7: Deployment ===
# (k3s + Cloudflare Tunnel -- configured in k8s manifests)
